{
  "schema_version": 1,
  "name": "paper-search-comparison",
  "description": "Search-only comparison under the full wrench model. Native cases use the standard staged grasp alphabet; imported Fabrica cases use tracked plain scene configs and the dense fixed grasp alphabet required by their CAD geometry. Within each case, rows differ only in the high-level decomposition or reverse/forward search policy.",
  "timeout_s": 450,
  "max_rss_gb": 4,
  "seeds": [11023, 11024, 11025],
  "env": {
    "OPENBLAS_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  },
  "defaults": [
    "--wrench", "--wrench-profile", "max_robotiq",
    "--no-fill-action-widening"
  ],
  "cases": [
    {
      "name": "cross",
      "args": [
        "--search-profile", "standard",
        "--assembly", "cross", "--parts", "7", "--num-robots", "4",
        "--robot", "ur10_limited", "--scatter-spacing", "0.2",
        "--insert-force", "10"
      ]
    },
    {
      "name": "stool",
      "timeout_s": 450,
      "args": [
        "--search-profile", "standard",
        "--assembly", "peg-stool-cuboid-4-tight-chamfer", "--parts", "5",
        "--num-robots", "4", "--robot", "ur5_limited",
        "--grippers", "vacuum,two_finger,two_finger,vacuum",
        "--vacuum-engage-force", "5", "--two-finger-scale", "10000",
        "--insert-force", "0.1", "--scatter-spacing", "0.2",
        "--grasp-sampler-wrap", "0.1", "--witness-margin", "0.0001",
        "--strict-collisions", "0.0001"
      ]
    },
    {
      "name": "chair",
      "timeout_s": 450,
      "args": [
        "--search-profile", "standard",
        "--assembly", "chair", "--parts", "8", "--num-robots", "4",
        "--robot", "ur10_limited",
        "--grippers", "vacuum,vacuum,two_finger,two_finger",
        "--allow-curved-grasps", "--scatter-spacing", "0.2",
        "--insert-force", "10"
      ]
    },
    {
      "name": "fabrica-stool",
      "timeout_s": 450,
      "args": [
        "--search-profile", "fabrica",
        "--config", "benchmarks/configs/fabrica/circular-stool.json"
      ]
    },
    {
      "name": "cooling",
      "timeout_s": 450,
      "args": [
        "--search-profile", "fabrica",
        "--config", "benchmarks/configs/fabrica/cooling-manifold.json"
      ]
    },
    {
      "name": "duct",
      "timeout_s": 450,
      "args": [
        "--search-profile", "fabrica",
        "--config", "benchmarks/configs/fabrica/duct.json"
      ]
    },
    {
      "name": "gamepad",
      "timeout_s": 450,
      "args": [
        "--search-profile", "fabrica",
        "--config", "benchmarks/configs/fabrica/gamepad.json"
      ]
    },
    {
      "name": "plumbers-block",
      "timeout_s": 450,
      "args": [
        "--search-profile", "fabrica",
        "--config", "benchmarks/configs/fabrica/plumbers-block.json"
      ]
    },
    {
      "name": "beam",
      "timeout_s": 450,
      "args": [
        "--search-profile", "fabrica",
        "--config", "benchmarks/configs/fabrica/beam.json"
      ]
    },
    {
      "name": "fabrica-car",
      "timeout_s": 450,
      "args": [
        "--search-profile", "fabrica",
        "--config", "benchmarks/configs/fabrica/car.json"
      ]
    }
  ],
  "variants": [
    {
      "name": "optimistic",
      "description": "Dogar-style fixed-order independent part fills; no exact global fallback.",
      "args": [
        "--optimistic", "--no-optimistic-fallback", "--no-fill-local-h",
        "--no-fill-greedy", "--no-fill-exact", "--no-placement-yaw-widening"
      ]
    },
    {
      "name": "ours",
      "description": "Standard structural milestones, local reverse PDB, greedy concrete fills, and open witnesses.",
      "args": []
    },
    {
      "name": "flat-lazy",
      "description": "Global LazySP-style task search without milestone decomposition.",
      "args": [
        "--lazy", "--no-milestones", "--no-fill-local-h", "--no-fill-greedy",
        "--no-fill-exact", "--no-placement-yaw-widening"
      ]
    },
    {
      "name": "milestones-counting",
      "description": "Matched standard milestone planner with the local reverse PDB replaced by counting guidance.",
      "args": ["--no-fill-local-h", "--fill-greedy", "--no-fill-exact"]
    },
    {
      "name": "ours-exact-fills",
      "description": "Matched method with weight-one A* rather than greedy best-first inside every concrete fill.",
      "args": ["--fill-local-h", "--fill-exact", "--no-fill-greedy"]
    },
    {
      "name": "ours-fine-projection",
      "description": "Matched standard milestone/greedy-fill method whose local reverse PDB uses press, pick-face, solo-holder, and brace-side labels rather than only insertion-force transmission.",
      "args": [
        "--sig-components", "press,pickface,solohold,braceside"
      ]
    }
  ]
}
